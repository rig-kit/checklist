{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklist-sync",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  // SQLite-backed objects are the kind the free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Limiter"] }],
  "vars": {
    // Sites allowed to use this service (comma-separated).
    "ALLOWED_ORIGINS": "https://rig-kit.github.io"
  }
}
