{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rigkit-planner",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ORDERS", "class_name": "Order" },
      { "name": "GATE", "class_name": "Gate" },
      { "name": "INTERVIEWS", "class_name": "Interview" }
    ]
  },
  // SQLite-backed objects are the kind the free plan allows.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Order", "Gate"] },
    { "tag": "v2", "new_sqlite_classes": ["Interview"] }
  ],
  "vars": {
    "PUBLIC_URL": "https://rigkit-planner.rigkit31.workers.dev",
    // Hard cap on what one plan may spend on Claude and run time, in cents.
    "SESSION_BUDGET_CENTS": "600",
    "ORDERS_PER_DAY": "10",
    "CHAT_TURNS_PER_DAY": "600"
  }
  // Secrets (set by the deploy workflow): ANTHROPIC_API_KEY, GOOGLE_PLACES_API_KEY, ACCESS_CODE, optional RESEND_API_KEY.
}
